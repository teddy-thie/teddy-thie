{
  "$description": "Design tokens for tedthie.cc. This file is the single source: tools/build-tokens.mjs turns it into site/css/tokens.css, and the Figma variables are generated from it too. Format: W3C design tokens ($value, $type, {aliases}). Fluid sizes keep their desktop value in $value and the clamp() range in $extensions.",
  "$extensions": {
    "cc.tedthie.contrast": {
      "$description": "Colour pairs the site actually uses. tools/check-tokens.mjs fails if one drops below its minimum: 4.5 for text, 3 for large text and interface parts (WCAG 2.2 AA).",
      "pairs": [
        ["color.text.ink",           "color.surface.paper",      "Headings and text",            4.5],
        ["color.text.body",          "color.surface.paper",      "Long-form text",               4.5],
        ["color.text.sub",           "color.surface.paper",      "Captions",                     4.5],
        ["color.text.sub",           "color.surface.card",       "Captions on cards",            4.5],
        ["color.text.sub",           "color.surface.well",       "Notes in demo panels",         4.5],
        ["color.brand.cobalt",       "color.surface.paper",      "Labels and links",             4.5],
        ["color.text.on-cobalt",     "color.brand.cobalt",       "Buttons",                      4.5],
        ["color.brand.cobalt",       "color.text.on-cobalt",     "Current page in the nav",      4.5],
        ["color.text.on-cobalt",     "color.surface.night-deep", "Hero text",                    4.5],
        ["color.text.on-cobalt-sub", "color.surface.night-deep", "Hero secondary text",          4.5],
        ["color.text.on-cobalt-soft","color.surface.night-deep", "Hero labels",                  4.5],
        ["color.text.night-sub",     "color.surface.night",      "Text on dark bands",           4.5],
        ["color.text.night-faint",   "color.surface.night",      "Captions on dark bands",       4.5],
        ["color.brand.periwinkle",   "color.surface.night",      "Accents on dark bands",        4.5],
        ["color.surface.paper",      "color.text.ink",           "Tags",                         4.5],
        ["color.status.error",       "color.surface.paper",      "Error messages",               4.5],
        ["color.surface.white",      "color.presentation.emr-teal", "KenyaEMR's pay button",     4.5],
        ["color.brand.cobalt",       "color.surface.card",       "Focus ring on a card",         3]
      ]
    }
  },

  "color": {
    "$type": "color",
    "brand": {
      "cobalt":        { "$value": "#3F44B0", "$description": "Primary action, links, focus rings" },
      "cobalt-hover":  { "$value": "#4C52C4", "$description": "Primary action on hover" },
      "periwinkle":    { "$value": "#8FA4F5", "$description": "Accent on dark bands" }
    },
    "surface": {
      "paper":         { "$value": "#F4F3F0", "$description": "Page background" },
      "card":          { "$value": "#FFFFFF", "$description": "Cards and raised objects" },
      "well":          { "$value": "#E8E7E2", "$description": "Sunken areas: demo panels, placeholders" },
      "tile":          { "$value": "#E3E2DD", "$description": "Image tiles behind screenshots" },
      "night":         { "$value": "#15161A", "$description": "Dark bands and the footer" },
      "night-deep":    { "$value": "#0B0B0E", "$description": "Behind the hero glow and night stages" },
      "white":         { "$value": "#FFFFFF", "$description": "Pure white on images and controls, whatever the surface" }
    },
    "text": {
      "ink":           { "$value": "#15161A", "$description": "Headings and primary text" },
      "body":          { "$value": "#3A3B40", "$description": "Long-form body text" },
      "sub":           { "$value": "#55565C", "$description": "Secondary text and captions" },
      "on-cobalt":     { "$value": "#F4F3F0", "$description": "Text on the hero and dark bands" },
      "on-cobalt-sub": { "$value": "#DCE1FA", "$description": "Secondary text on the hero" },
      "on-cobalt-soft":{ "$value": "#C9D2F7", "$description": "Tertiary text on the hero" },
      "night-sub":     { "$value": "#C8C9CE", "$description": "Secondary text on dark bands" },
      "night-faint":   { "$value": "#A3A4AA", "$description": "Tertiary text on dark bands" }
    },
    "line": {
      "line":          { "$value": "#DCDBD6", "$description": "Default divider" },
      "line-strong":   { "$value": "#D2D1CB", "$description": "Control borders" },
      "night-line":    { "$value": "#3A3B42", "$description": "Borders on dark bands" },
      "night-rule":    { "$value": "#2D2E33", "$description": "Dividers on dark bands" },
      "on-cobalt-line":  { "$value": "rgba(244, 243, 240, .3)",  "$description": "Dividers on the hero" },
      "on-cobalt-ghost": { "$value": "rgba(244, 243, 240, .4)",  "$description": "Outline buttons on the hero" },
      "line-on-night":   { "$value": "rgba(255, 255, 255, .25)", "$description": "Control borders over photos and the lightbox" }
    },
    "fill": {
      "on-cobalt-fill":   { "$value": "rgba(244, 243, 240, .16)", "$description": "Placeholder fill on the hero" },
      "scrim-paper":      { "$value": "rgba(244, 243, 240, .92)", "$description": "Paper scrim over a blurred preview" },
      "overlay-lightbox": { "$value": "rgba(13, 13, 16, .97)",    "$description": "Lightbox backdrop" },
      "control-night":    { "$value": "rgba(21, 22, 26, .8)",     "$description": "Round control on the lightbox" }
    },
    "glow": {
      "glow-sky":    { "$value": "rgba(97, 166, 250, .30)", "$description": "Top-right glow in the hero" },
      "glow-cobalt": { "$value": "rgba(63, 68, 176, .35)",  "$description": "Bottom-left glow in the hero" }
    },
    "status": {
      "error":       { "$value": "#B42318", "$description": "Errors, such as a wrong password" }
    },
    "presentation": {
      "screen-paper":     { "$value": "#FBFAF8", "$description": "Behind light screenshots while they load" },
      "screen-night":     { "$value": "#09090B", "$description": "Behind dark screenshots" },
      "phone-body":       { "$value": "#1C1C21", "$description": "Phone frame around mobile screenshots" },
      "panel-grey":       { "$value": "#F4F4F4", "$description": "Neutral panel behind before/after pairs" },
      "label-night":      { "$value": "#1A1A1D", "$description": "Dark label on the light/dark comparison" },
      "label-night-text": { "$value": "#F4F5F7", "$description": "Text on the dark comparison label" },
      "emr-teal":         { "$value": "#007D79", "$description": "KenyaEMR's action colour, used where the case study shows its UI" }
    }
  },

  "gradient": {
    "$type": "gradient",
    "hero-bg":      { "$value": "radial-gradient(55% 75% at 78% 8%, {color.glow.glow-sky}, transparent 70%), radial-gradient(45% 60% at 8% 100%, {color.glow.glow-cobalt}, transparent 70%), {color.surface.night-deep}", "$description": "The hero band: two glows over near-black" },
    "fade-caption": { "$value": "linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, .6))", "$description": "Darkens the bottom of a photo so its caption reads" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": "'Hanken Grotesk', 'Helvetica Neue', Arial, sans-serif", "$description": "Headings" },
      "body":    { "$value": "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif", "$description": "Body text and UI" },
      "accent":  { "$value": "'Instrument Serif', Georgia, 'Times New Roman', serif", "$description": "Italic accents and big numerals" },
      "mono":    { "$value": "'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace", "$description": "Labels, tags, numbers" }
    },
    "size": {
      "$type": "dimension",
      "micro":      { "$value": "11px", "$description": "Mono tags, figure captions, small labels" },
      "label":      { "$value": "12px", "$description": "Mono section labels and counters" },
      "small":      { "$value": "14px", "$description": "Meta text and fine print" },
      "ui":         { "$value": "15px", "$description": "Navigation, buttons, field labels" },
      "body":       { "$value": "16px", "$description": "Default body text" },
      "body-lg":    { "$value": "17px", "$description": "Card text, captions, large buttons" },
      "title-sm":   { "$value": "22px", "$description": "Card and step titles" },
      "title":      { "$value": "24px", "$description": "Timeline and system titles" },
      "title-lg":   { "$value": "28px", "$description": "Project card titles" },
      "heading":    { "$value": "32px", "$description": "Small section headings" },
      "numeral-sm": { "$value": "44px", "$description": "Big italic numerals on phones" },
      "numeral":    { "$value": "56px", "$description": "Big italic numerals" }
    },
    "fluid": {
      "$type": "dimension",
      "display-hero":   { "$value": "96px",  "$extensions": { "cc.tedthie.fluid": { "min": "52px", "vw": "6.7vw", "max": "96px" } },  "$description": "Home and password-page headline" },
      "display-case":   { "$value": "104px", "$extensions": { "cc.tedthie.fluid": { "min": "52px", "vw": "7.2vw", "max": "104px" } }, "$description": "Case-study headline" },
      "display-footer": { "$value": "64px",  "$extensions": { "cc.tedthie.fluid": { "min": "40px", "vw": "4.4vw", "max": "64px" } },  "$description": "Footer call to action" },
      "display-stat":   { "$value": "112px", "$extensions": { "cc.tedthie.fluid": { "min": "80px", "vw": "7.8vw", "max": "112px" } }, "$description": "Headline numbers in case studies" },
      "heading-xl":     { "$value": "56px",  "$extensions": { "cc.tedthie.fluid": { "min": "40px", "vw": "3.9vw", "max": "56px" } },  "$description": "Large section headings" },
      "heading-lg":     { "$value": "48px",  "$extensions": { "cc.tedthie.fluid": { "min": "36px", "vw": "3.4vw", "max": "48px" } },  "$description": "Section headings" },
      "lede-lg":        { "$value": "28px",  "$extensions": { "cc.tedthie.fluid": { "min": "22px", "vw": "2vw",   "max": "28px" } },  "$description": "Case-study subtitle, overview and quotes" },
      "lede":           { "$value": "24px",  "$extensions": { "cc.tedthie.fluid": { "min": "19px", "vw": "1.7vw", "max": "24px" } },  "$description": "About page introduction" },
      "lede-sm":        { "$value": "21px",  "$extensions": { "cc.tedthie.fluid": { "min": "18px", "vw": "1.5vw", "max": "21px" } },  "$description": "Home introduction and outcome lists" },
      "prose":          { "$value": "19px",  "$extensions": { "cc.tedthie.fluid": { "min": "17px", "vw": "1.35vw","max": "19px" } },  "$description": "Long-form case-study text" }
    },
    "leading": {
      "$type": "number",
      "numeral": { "$value": 0.9,  "$description": "Big numerals" },
      "none":    { "$value": 1,    "$description": "Display numbers and one-line headings" },
      "tight":   { "$value": 1.05, "$description": "Multi-line headings" },
      "snug":    { "$value": 1.3,  "$description": "Ledes and subtitles" },
      "compact": { "$value": 1.4,  "$description": "Short captions and meta values" },
      "normal":  { "$value": 1.5,  "$description": "UI text" },
      "body":    { "$value": 1.55, "$description": "Card and caption text" },
      "relaxed": { "$value": 1.6,  "$description": "Paragraphs" },
      "loose":   { "$value": 1.65, "$description": "Long-form prose" }
    },
    "tracking": {
      "$type": "dimension",
      "tightest": { "$value": "-0.045em", "$description": "Hero headlines" },
      "tighter":  { "$value": "-0.035em", "$description": "Large headings" },
      "tight":    { "$value": "-0.025em", "$description": "Section headings" },
      "snug":     { "$value": "-0.015em", "$description": "Titles" },
      "slight":   { "$value": "-0.01em",  "$description": "Ledes and big italic text" },
      "wide":     { "$value": "0.02em",   "$description": "Small mono values" },
      "mono":     { "$value": "0.06em",   "$description": "Mono text" },
      "caps":     { "$value": "0.08em",   "$description": "Uppercase mono labels" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "A 4px scale with half steps. The name is the multiple of 4: space-6 is 24px, space-2-5 is 10px.",
    "px":  { "$value": "1px" },
    "0-5": { "$value": "2px" },
    "1":   { "$value": "4px" },
    "1-5": { "$value": "6px" },
    "2":   { "$value": "8px" },
    "2-5": { "$value": "10px" },
    "3":   { "$value": "12px" },
    "3-5": { "$value": "14px" },
    "4":   { "$value": "16px" },
    "4-5": { "$value": "18px" },
    "5":   { "$value": "20px" },
    "6":   { "$value": "24px" },
    "7":   { "$value": "28px" },
    "8":   { "$value": "32px" },
    "9":   { "$value": "36px" },
    "10":  { "$value": "40px" },
    "11":  { "$value": "44px" },
    "12":  { "$value": "48px" },
    "14":  { "$value": "56px" },
    "16":  { "$value": "64px" },
    "18":  { "$value": "72px" },
    "22":  { "$value": "88px" },
    "24":  { "$value": "96px" },
    "28":  { "$value": "112px" },
    "30":  { "$value": "120px" }
  },

  "layout": {
    "$type": "dimension",
    "gutter":  { "$value": "56px",  "$extensions": { "cc.tedthie.fluid": { "min": "20px", "vw": "3.9vw", "max": "56px" } },  "$description": "Page side padding" },
    "section": { "$value": "120px", "$extensions": { "cc.tedthie.fluid": { "min": "72px", "vw": "8.4vw", "max": "120px" } }, "$description": "Space between page sections" },
    "phone-bezel": { "$value": "7px", "$description": "Frame around phone screenshots" }
  },

  "radius": {
    "$type": "dimension",
    "xs":           { "$value": "4px",   "$description": "Focus rings, colour chips, placeholders" },
    "sm":           { "$value": "8px",   "$description": "Small screens and swatches" },
    "md":           { "$value": "12px",  "$description": "Screenshots and token cards" },
    "lg":           { "$value": "16px",  "$description": "Photos and small panels" },
    "xl":           { "$value": "20px",  "$description": "Cards" },
    "2xl":          { "$value": "24px",  "$description": "Hero screenshots and previews" },
    "3xl":          { "$value": "28px",  "$description": "Stages and demo panels" },
    "phone":        { "$value": "42px",  "$description": "Phone frame" },
    "phone-screen": { "$value": "35px",  "$description": "Screen inside the phone frame" },
    "pill":         { "$value": "999px", "$description": "Buttons, tags and pills" },
    "round":        { "$value": "50%",   "$description": "Circles" }
  },

  "shadow": {
    "$type": "shadow",
    "shadow-hairline":    { "$value": "0 1px 0 rgba(21, 22, 26, .06)", "$description": "Resting project card" },
    "shadow-pop":         { "$value": "0 12px 32px -12px rgba(21, 22, 26, .45)", "$description": "Cursor card" },
    "shadow-pop-soft":    { "$value": "0 12px 32px -12px rgba(21, 22, 26, .3)", "$description": "Cursor card, coming soon" },
    "shadow-panel":       { "$value": "0 20px 48px -20px rgba(21, 22, 26, .35)", "$description": "Interactive panel on a demo" },
    "shadow-step":        { "$value": "0 24px 64px -32px rgba(21, 22, 26, .35)", "$description": "Screens in a stepper" },
    "shadow-float-soft":  { "$value": "0 24px 64px -24px rgba(21, 22, 26, .35)", "$description": "Case-study hero screenshot" },
    "shadow-float":       { "$value": "0 24px 64px -24px rgba(21, 22, 26, .45)", "$description": "Hero stage and locked preview" },
    "shadow-screen-drop": { "$value": "0 28px 56px -30px rgba(21, 22, 26, .4)", "$description": "Drop under a framed screen" },
    "shadow-screen":      { "$value": "0 0 0 1px rgba(21, 22, 26, .08), 0 2px 4px rgba(21, 22, 26, .04), {shadow.shadow-screen-drop}", "$description": "Framed light screen" },
    "shadow-screen-night":{ "$value": "0 0 0 1px rgba(255, 255, 255, .09), 0 40px 80px -36px rgba(0, 0, 0, .85)", "$description": "Framed dark screen" },
    "shadow-phone":       { "$value": "0 0 0 1px rgba(255, 255, 255, .12), 0 40px 80px -30px rgba(0, 0, 0, .75)", "$description": "Phone frame" },
    "shadow-knob":        { "$value": "0 4px 16px rgba(0, 0, 0, .35)", "$description": "Drag handle" },
    "ring-swatch":        { "$value": "inset 0 0 0 1px rgba(0, 0, 0, .12)", "$description": "Edge on a round colour swatch" },
    "ring-chip":          { "$value": "inset 0 0 0 1px rgba(0, 0, 0, .15)", "$description": "Edge on a square colour chip" },
    "ring-night":         { "$value": "inset 0 0 0 1px rgba(255, 255, 255, .06)", "$description": "Edge of a night stage" },
    "ring-token-swatch":  { "$value": "inset 0 0 0 1px rgba(255, 255, 255, .14)", "$description": "Edge on a token swatch on a dark band" },
    "ring-lightbox":      { "$value": "0 0 0 1px rgba(255, 255, 255, .1)", "$description": "Edge of the lightbox image" },
    "ring-handle":        { "$value": "0 0 0 1px rgba(0, 0, 0, .25)", "$description": "Edge of the comparison line" },
    "ring-label":         { "$value": "0 0 0 1px rgba(21, 22, 26, .12)", "$description": "Edge of a light label" },
    "ring-label-night":   { "$value": "0 0 0 1px rgba(255, 255, 255, .14)", "$description": "Edge of a dark label" }
  }
}
